# The workflow decides whether to commit by diffing data.json and archive.json,
# and both generators write LF. Checking these out as CRLF on Windows would make
# every local run look like a whole-file change.
*.py                text eol=lf
*.yml               text eol=lf
data.json           text eol=lf
archive.json        text eol=lf
ticker.svg          text eol=lf
ticker.template.svg text eol=lf
index.html          text eol=lf
*.md                text eol=lf
